{
  "name": "customer-finder-pro",
  "version": "1.0.0",
  "description": "Ứng dụng tìm kiếm, tạo nội dung và lên lịch đăng đa nền tảng",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.3.2",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.40.0",
    "prettier": "^2.8.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "zalo:server": "node server/zalo-server.js",
    "linkedin:server": "node server/linkedin-server.js",
    "real-estate:server": "node server/real-estate-server.js"
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "keywords": ["facebook", "instagram", "tiktok", "zalo", "linkedin", "real-estate", "customer", "scheduler", "social-media"],
  "license": "MIT"
}
