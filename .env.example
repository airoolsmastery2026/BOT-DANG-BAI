# Backend scheduler example only (server/scheduler-example.js)
FACEBOOK_TOKEN=

# Zalo OA server (server/zalo-server.js)
ZALO_OA_ACCESS_TOKEN=
ZALO_SERVER_API_KEY=
ZALO_SERVER_HOST=0.0.0.0
ZALO_SERVER_PORT=8787
ZALO_ALLOWED_ORIGIN=http://localhost:3000
# Optional: override storage location or OpenAPI endpoint.
# ZALO_STORE_PATH=./server/zalo-messages.json
# ZALO_OA_ENDPOINT=https://openapi.zalo.me/v3.0/oa/message/cs

# LinkedIn server (server/linkedin-server.js)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202605
LINKEDIN_SERVER_API_KEY=
LINKEDIN_SERVER_HOST=0.0.0.0
LINKEDIN_SERVER_PORT=8790
LINKEDIN_ALLOWED_ORIGIN=http://localhost:3000
LINKEDIN_MAX_ATTEMPTS=3
# Optional overrides.
# LINKEDIN_STORE_PATH=./server/linkedin-posts.json
# LINKEDIN_POSTS_ENDPOINT=https://api.linkedin.com/rest/posts

# Đại Hải Phát ecosystem bridge (server-side / Vercel only)
DHP_WEBSITE_BASE_URL=
ECOSYSTEM_WEBHOOK_SECRET=
BOT_INGEST_TOKEN=

# DHP Media Inbox — local operator service only.
DHP_MEDIA_INGRESS_TOKEN=replace-with-a-long-random-local-secret
DHP_MEDIA_INGRESS_HOST=127.0.0.1
DHP_MEDIA_INGRESS_PORT=8791
DHP_MEDIA_ALLOWED_ORIGIN=http://localhost:3000
DHP_MEDIA_INBOX_PATH=./server/dhp-media-inbox.json

# Optional cloud sync from DHP Agent Control Plane.
DHP_CONTROL_PLANE_URL=
DHP_CONTROL_PLANE_KEY_ID=
DHP_CONTROL_PLANE_SECRET=
DHP_MEDIA_CLOUD_SYNC_INTERVAL_MS=30000
DHP_MEDIA_CLOUD_TIMEOUT_MS=15000

# Publishing runtime control — local service/Telegram boundary.
# If token below is empty, server may reuse DHP_MEDIA_INGRESS_TOKEN.
DHP_PUBLISHING_CONTROL_TOKEN=
DHP_PUBLISHING_CONTROL_URL=http://127.0.0.1:8792
DHP_PUBLISHING_CONTROL_HOST=127.0.0.1
DHP_PUBLISHING_CONTROL_PORT=8792
DHP_PUBLISHING_CONTROL_ORIGIN=http://localhost:3000
DHP_PUBLISHING_CONTROL_PATH=./server/dhp-publishing-control.json

# Telegram Control — local long-polling process; no inbound public webhook required.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs with roles, e.g. 123456789:owner,987654321:viewer
TELEGRAM_CONTROL_OPERATORS=
TELEGRAM_POLL_TIMEOUT_SECONDS=25
# Must match Website ECOSYSTEM_SERVICE_API_KEY; keep server-side only.
TELEGRAM_WEBSITE_SERVICE_TOKEN=

# Local CRA UI only. Never set these tokens in a public Vercel build because REACT_APP_* is bundled to the browser.
REACT_APP_DHP_MEDIA_INGRESS_URL=http://127.0.0.1:8791
REACT_APP_DHP_MEDIA_INGRESS_TOKEN=
REACT_APP_DHP_PUBLISHING_CONTROL_URL=http://127.0.0.1:8792
REACT_APP_DHP_PUBLISHING_CONTROL_TOKEN=

# Security: never expose platform/client secrets through REACT_APP_* variables.
