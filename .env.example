# Backend scheduler example only (server/scheduler-example.js)
FACEBOOK_TOKEN=

# Zalo OA server (server/zalo-server.js)
ZALO_OA_ACCESS_TOKEN=
ZALO_SERVER_API_KEY=
ZALO_SERVER_HOST=0.0.0.0
ZALO_SERVER_PORT=8787
ZALO_ALLOWED_ORIGIN=http://localhost:3000
# Optional: override storage location or OpenAPI endpoint.
# ZALO_STORE_PATH=./server/zalo-messages.json
# ZALO_OA_ENDPOINT=https://openapi.zalo.me/v3.0/oa/message/cs

# Security: never expose client secrets through REACT_APP_* variables.
# CRA embeds every REACT_APP_* value into the public browser bundle.
